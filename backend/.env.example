HOST=127.0.0.1
PORT=8000
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-at-least-32-random-characters
JWT_EXPIRE_HOURS=24
# Set to 1 behind HTTPS so the session cookie is marked Secure.
# COOKIE_SECURE=1
# Login/register rate limits apply to non-loopback clients. Set 1 to also limit localhost.
# AUTH_RATE_LIMIT_LOCAL=1
# Lower rounds (e.g. 4) speeds up load-test user seeding in dev only — never use in production.
# BCRYPT_ROUNDS=12

# Comma-separated browser origins allowed to call the API (required for separate frontend deploy).
# Use * for local dev only. In production, list your GitHub Pages URL and/or custom domain:
# CORS_ORIGINS=https://yourname.github.io,https://chat.yourdomain.com
CORS_ORIGINS=*

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=chatapp
POSTGRES_PASSWORD=yourpassword
POSTGRES_DB=chatapp
POSTGRES_POOL_MIN=2
POSTGRES_POOL_MAX=20

# Batch chat inserts before flushing to Postgres (reduces write load at scale).
# Set MESSAGE_BATCH_SIZE=1 for immediate single-row inserts (lowest latency).
MESSAGE_BATCH_SIZE=25
MESSAGE_FLUSH_MS=50

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CHAT_CHANNEL=chat:messages
REDIS_INBOUND_CHANNEL=chat:inbound
REDIS_ONLINE_KEY=chat:online_users
REDIS_USERNAME_KEY=chat:usernames

# Maximum concurrent WebSocket connections per group (shared by FastAPI + Erlang).
MAX_GROUP_USERS=1000

# Erlang/OTP messaging node
# Erlang reads these keys from this same file at startup (shared with FastAPI).
ERLANG_WS_PORT=8080

# Voice-to-text via SpeechRecognition (Google speech API from the server).
# TRANSCRIBE_LANGUAGE=en-US
# TRANSCRIBE_MAX_BYTES=5242880

# WebRTC video/voice calls.
# Signaling always goes through Erlang WS. Media is P2P by default.
# Set WEBRTC_MODE=sfu and pip install aiortc to relay media through Python.
# WEBRTC_MODE=p2p
# TURN_URL=turn:turn.example.com:3478
# TURN_USERNAME=
# TURN_PASSWORD=

# Optional community admin. If this user exists, they are promoted to admin.
# If they do not exist and ADMIN_PASSWORD is set, the account is created on startup.
# If no admins exist yet, the first person to register becomes admin.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin
