# Shared by FastAPI and Erlang in Docker Desktop. Not for production.
SECRET_KEY=docker-desktop-local-secret-key-min-32-chars
JWT_EXPIRE_HOURS=24
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1,http://localhost
COOKIE_SECURE=0

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=chatapp
POSTGRES_PASSWORD=yourpassword
POSTGRES_DB=chatapp
POSTGRES_POOL_MIN=2
POSTGRES_POOL_MAX=20

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CHAT_CHANNEL=chat:messages
REDIS_INBOUND_CHANNEL=chat:inbound
REDIS_ONLINE_KEY=chat:online_users
REDIS_USERNAME_KEY=chat:usernames

MAX_GROUP_USERS=1000
ERLANG_WS_PORT=8080
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin
